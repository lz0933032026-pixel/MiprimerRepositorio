Algoritmo Divisible3o5
	//Lo que tenemos que hacer: Solicitar un numero y mostrar verdadero si es divisble por 3
	//o por 5,usando el operador logico OR
	
	Escribir "Ingrese un numero"
	Leer numero
	
	Si numero % 3 = 0 o numero % 5 = 0 Entonces
		Escribir "Verdadero"
	SiNo
		Escribir "Falso" 
	Fin Si
	
FinAlgoritmo
