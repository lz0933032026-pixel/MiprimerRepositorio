Algoritmo SumaResta
	//Meta: Solictar dos numeros al usuario y mostrar la suma y resta
	
	Escribir "Ingresar el primer numero"
	Leer num1
	
	Escribir"Ingresar el segundo numero"
	Leer num2
	
	suma <- num1 + num2
	resta <- num1 - num2
	
	Escribir "La suma de los dos numeros es : suma "
	Escribir "La resta de los dos numeros es : resta"
	
FinAlgoritmo
